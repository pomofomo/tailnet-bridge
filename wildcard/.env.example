# Tailnet Community Bridge (wildcard variant) — example environment file.
#
# Copy to .env and replace each placeholder with the real auth key:
#
#   cp .env.example .env
#   $EDITOR .env
#
# docker-compose.yml refuses to start (and `make image` / `docker compose
# build` refuses to interpolate) when PERSONAL_TAILNET_AUTHKEY is missing,
# so .env must exist before any compose command.
#
# Auth-key names below MUST match the `auth_key_env:` values in config.yml.
# When you add a community to config.yml, add its env var here AND in the
# `environment:` block of docker-compose.yml.

# Personal tailnet auth key (required).
# Generate at https://login.tailscale.com/admin/settings/keys
# Recommended: Reusable=yes, Ephemeral=no, Pre-authorized=yes.
PERSONAL_TAILNET_AUTHKEY=tskey-auth-REPLACE-ME

# Community auth keys (one per community in config.yml).
# Obtain each from the respective community admin out-of-band.
SMITHFAMILY_AUTHKEY=tskey-auth-REPLACE-ME
# AUSTINMAKERS_AUTHKEY=tskey-auth-REPLACE-ME
